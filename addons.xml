<?xml version="1.0" encoding="UTF-8"?>
<addons>
  <addon id="script.splash.cycler"
         version="9.1.4"
         name="Splash Cycler"
         provider-name="Bigmoco">
    <extension point="xbmc.service" library="default.py" start="startup"/>
    <requires>
      <import addon="xbmc.python" version="3.0.0"/>
    </requires>
  </addon>
  <addon id="skin.auramod" version="3.0.7" name="AuraMOD" provider-name="skyfsza,inb4after,SerpentDrago">
    <requires>
      <import addon="xbmc.gui" version="5.17.0"/>
      <import addon="script.skin.helper.service" version="1.1.24"/>
      <import addon="script.skinshortcuts" version="1.0.20"/>
      <import addon="script.image.resource.select" version="0.0.5"/>
    </requires>
    <extension point="xbmc.gui.skin" defaultthemename="Textures.xbt" debugging="false" effectslowdown="1">
      <res width="1920" height="1080" aspect="16:9" default="true" folder="1080i"/>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en">AuraMod zonder verplichte TMDb Helper</summary>
      <description lang="en">AuraMod for addon streaming. TMDb Helper is optional: Play, Info and widgets use the addon listitem when it is not installed.</description>
      <platform>all</platform>
      <license>Creative Commons Attribution Non-Commercial Share-Alike 4.0</license>
      <assets>
        <icon>icon.png</icon>
        <fanart>fanart.jpg</fanart>
      </assets>
      <news>
        v3.0.5 - TMDb Helper is optional. Play/Info work from the addon item. Widgets and search paths that call plugin.video.themoviedb.helper only load when that addon is installed. v3.0.6 - Home widgets default to 10 items. Skin Helper PVR thumbs and music art are no longer forced on. Home menu animation is shorter. v3.0.7 - Movie title clearlogos keep their aspect ratio.
      </news>
    </extension>
  </addon>
  <addon id="plugin.program.mootjuhswiz" name="Mootjuh's Wiz" version="3.9.7" provider-name="Group Effort">
    <requires>
      <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">This Wizard is a tool for backup/restore and maintenance of Kodi builds. Forked from simplewizard.</summary>
      <description lang="en_GB">Kodi Wizard</description>
      <platform>all</platform>
      <license>GPL-2.0-or-later</license>
    </extension>
  </addon>
  <addon id="repository.batmudz" name="Batmudz Repository" version="1.0.3" provider-name="batmudz">
    <requires>
      <import addon="xbmc.addon" version="12.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="Batmudz Repository">
      <dir>
        <info compressed="false">https://raw.githubusercontent.com/batmudz/kodi-repo/main/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/batmudz/kodi-repo/main/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/batmudz/kodi-repo/main/zips/</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary>Eigen Kodi repository</summary>
      <description>Repository voor losse addons.</description>
      <platform>all</platform>
    </extension>
  </addon>
  <addon id="plugin.program.shortcutmanager" name="Shortcut Manager" version="9.1.2" provider-name="Bob">
    <requires>
      <import addon="script.module.pil"/>
      <import addon="script.module.six"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary>Shortcut Manager</summary>
      <platform>all</platform>
    </extension>
  </addon>
<addon id="skin.nimbus" version="0.2.12" name="Nimbus Plus"
	provider-name="adamsbuilds, Ivar Brandt">
	<requires>
		<import addon="xbmc.gui" version="5.17.0" />
		<import addon="script.nimbus.helper" version="0.1.01"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false">
		<res width="1920" height="1440" aspect="4:3" default="false" folder="xml" />
		<res width="1920" height="1280" aspect="3:2" default="false" folder="xml" />
		<res width="1920" height="1200" aspect="16:10" default="false" folder="xml" />
		<res width="2040" height="1080" aspect="17:9" default="false" folder="xml" />
		<res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
		<res width="2560" height="1080" aspect="21:9" default="false" folder="xml" />
		<res width="2338" height="1080" aspect="19.5:9" default="false" folder="xml" />
		<res width="2160" height="1080" aspect="18:9" default="false" folder="xml" />
	</extension>
	<extension point="xbmc.addon.metadata">
		<platform>all</platform>
		<license>GPL-2.0-only, CC-BY-SA-4.0</license>
		<assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.png</fanart>
		</assets>
		<summary lang="en_GB">Nimbus Plus skin by adamsbuilds</summary>
		<summary lang="en_NZ">Nimbus Plus skin by adamsbuilds</summary>
		<summary lang="en_US">Nimbus Plus skin by adamsbuilds</summary>
		<description lang="en_GB">Nimbus Plus Skin by adamsbuilds, a fork of the Nimbus skin by Ivar Brandt.</description>
		<description lang="en_NZ">Nimbus Plus Skin by adamsbuilds, a fork of the Nimbus skin by Ivar Brandt.</description>
		<description lang="en_US">Nimbus Plus Skin by adamsbuilds, a fork of the Nimbus skin by Ivar Brandt.</description>
	</extension>
</addon>
</addons>
