<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.batmudz" name="Batmudz Repository" version="1.0.0" provider-name="batmudz">
    <requires>
        <import addon="xbmc.addon" version="12.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="Batmudz Repository">
        <info compressed="false">https://batmudz.github.io/kodi-repo/addons.xml</info>
        <checksum>https://batmudz.github.io/kodi-repo/addons.xml.md5</checksum>
        <datadir zip="true">https://batmudz.github.io/kodi-repo/zips/</datadir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>Eigen Kodi repository voor Nicole-build en updates</summary>
        <description>Repository voor losse addons (Red Light e.d.) zodat je niet steeds de volledige build hoeft te downloaden.</description>
        <platform>all</platform>
    </extension>
</addon>
